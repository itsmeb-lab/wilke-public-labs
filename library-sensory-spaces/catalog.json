  "rules": [
    {
      "operator": "durham-calming",
      "task": "walk-in",
      "fit": "listed",
      "text": "The policy allows use as needed without a reservation.",
      "source": "durham-calming-guide"
    },
    {
      "operator": "durham-calming",
      "task": "no-library-card",
      "fit": "listed",
      "text": "A library card is not required for this room.",
      "source": "durham-calming-guide"
    },
    {
      "operator": "durham-calming",
      "task": "dedicated-room",
      "fit": "listed",
      "text": "The Main Library lists a dedicated room for sensory calming.",
      "source": "durham-calming-guide"
    },
    {
      "operator": "durham-calming",
      "task": "child-supervision",
      "fit": "listed",
      "text": "An adult must supervise anyone under 15.",
      "source": "durham-calming-guide"
    },
    {
      "operator": "durham-calming",
      "task": "time-limit",
      "fit": "listed",
      "text": "The calming room can be used for up to 30 minutes in a day.",
      "source": "durham-calming-guide"
    },
    {
      "operator": "durham-mse",
      "task": "walk-in",
      "fit": "excluded",
      "text": "Use is limited to the hours of an approved reservation.",
      "source": "durham-mse-guide"
    },
    {
      "operator": "durham-mse",
      "task": "no-library-card",
      "fit": "excluded",
      "text": "A full-privileges Durham County Library card is required to reserve. Temporary and computer-use cards are ineligible.",
      "source": "durham-mse-guide"
    },
    {
      "operator": "durham-mse",
      "task": "dedicated-room",
      "fit": "listed",
      "text": "The library lists a separate room under the name Multi Sensory Environment.",
      "source": "durham-mse-guide"
    },
    {
      "operator": "durham-mse",
      "task": "child-supervision",
      "fit": "listed",
      "text": "An adult facilitator is required for a visit.",
      "source": "durham-mse-guide"
    },
    {
      "operator": "durham-mse",
      "task": "time-limit",
      "fit": "listed",
      "text": "The library schedules reservations in 30-minute increments and adds cleaning time. Check the requested slot with staff.",
      "source": "durham-mse-guide"
    },
    {
      "operator": "north-manchester",
      "task": "walk-in",
      "fit": "listed",
      "text": "No reservation is required.",
      "source": "north-manchester-guide"
    },
    {
      "operator": "north-manchester",
      "task": "dedicated-room",
      "fit": "listed",
      "text": "The library lists a designated quiet room with subdued lighting and equipment such as headphones.",
      "source": "north-manchester-guide"
    },
    {
      "operator": "north-manchester",
      "task": "child-supervision",
      "fit": "ask",
      "text": "The Quiet Room welcomes all ages. Check the library’s general supervision rules for a child’s visit.",
      "source": "north-manchester-guide"
    },
    {
      "operator": "toronto-stewart",
      "task": "walk-in",
      "fit": "excluded",
      "text": "The room is available by booking only. Same-day bookings can be requested.",
      "source": "toronto-stewart-guide"
    },
    {
      "operator": "toronto-stewart",
      "task": "dedicated-room",
      "fit": "listed",
      "text": "The Sensory Room is at the S. Walter Stewart branch.",
      "source": "toronto-stewart-guide"
    },
    {
      "operator": "toronto-stewart",
      "task": "child-supervision",
      "fit": "listed",
      "text": "The room is for children through age 12 with a parent or caregiver. Adult supervision is required.",
      "source": "toronto-stewart-guide"
    },
    {
      "operator": "toronto-stewart",
      "task": "time-limit",
      "fit": "listed",
      "text": "The branch offers sessions of 15 to 60 minutes during its regular hours.",
      "source": "toronto-stewart-guide"
    },
    {
      "operator": "moreton-bay",
      "task": "walk-in",
      "fit": "listed",
      "text": "The city explicitly waives bookings for the listed quiet hours.",
      "source": "moreton-bay-guide"
    },
    {
      "operator": "moreton-bay",
      "task": "dedicated-room",
      "fit": "excluded",
      "text": "Quiet Hour adjusts the library’s shared environment during the listed session.",
      "source": "moreton-bay-guide"
    },
    {
      "operator": "moreton-bay",
      "task": "child-supervision",
      "fit": "ask",
      "text": "The program lists all ages and describes itself as family friendly. Confirm the branch’s usual child supervision policy.",
      "source": "moreton-bay-guide"
    },
    {
      "operator": "moreton-bay",
      "task": "time-limit",
      "fit": "listed",
      "text": "Use the posted start and end times for the library you choose.",
      "source": "moreton-bay-guide"
    },
    {
      "operator": "queensland-corner",
      "task": "walk-in",
      "fit": "excluded",
      "text": "The library requires reservations for the free sensory-friendly sessions.",
      "source": "queensland-corner-guide"
    },
    {
      "operator": "queensland-corner",
      "task": "dedicated-room",
      "fit": "excluded",
      "text": "This route is a quieter scheduled session in The Corner. Check the session listing when you need that setting.",
      "source": "queensland-corner-guide"
    },
    {
      "operator": "queensland-corner",
      "task": "child-supervision",
      "fit": "ask",
      "text": "The operator describes these sessions as being for families. Confirm the details for the upcoming session you choose.",
      "source": "queensland-corner-guide"
    },
    {
      "operator": "queensland-corner",
      "task": "time-limit",
